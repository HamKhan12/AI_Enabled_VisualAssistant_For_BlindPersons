<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scene_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- CAMERA PREVIEW - top 55% -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewViewScene"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.55" />

    <!-- LANGUAGE TOGGLE BUTTON -->
    <Button
        android:id="@+id/btnLanguageToggle"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:text="🇺🇸 EN"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/language_button_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:letterSpacing="0.08"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- MUTE INDICATOR CARD -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/muteIndicatorCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="#F44336"
        app:cardCornerRadius="30dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔇"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/muteIndicatorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="MUTED"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- AUTO-CAPTURE INDICATOR PILL -->
    <TextView
        android:id="@+id/livePillScene"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● AUTO"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        android:background="#CC1B5E20"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="@id/previewViewScene"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- STATUS ROW -->
    <TextView
        android:id="@+id/sceneStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Starting…"
        android:textSize="13sp"
        android:textColor="#BBBBBB"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/previewViewScene"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- DIVIDER -->
    <View
        android:id="@+id/dividerScene"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#333333"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/sceneStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CAPTION LABEL -->
    <TextView
        android:id="@+id/tvCaptionLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Scene Description"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#888888"
        android:letterSpacing="0.1"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/dividerScene"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CAPTION TEXT SCROLLVIEW -->
    <ScrollView
        android:id="@+id/textPreviewScrollScene"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tvCaptionLabel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvSceneText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="17sp"
            android:textColor="#EEEEEE"
            android:lineSpacingMultiplier="1.4"
            android:fontFamily="sans-serif-light" />

    </ScrollView>

    <!-- HIDDEN STUBS -->
    <ImageButton
        android:id="@+id/btnCaptureScene"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnUploadScene"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/featurePanelScene"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnReadAloudScene"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>